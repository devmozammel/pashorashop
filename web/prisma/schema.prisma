generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // USER, ADMIN
  password      String?   // For credentials provider
  phone         String?
  resetToken    String?   @unique
  resetTokenExpiry DateTime?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  notifications Notification[]
  wishlist      Wishlist[]
  reviews       Review[]
  cart          Cart?
  affiliateProfile AffiliateProfile?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  shortDesc     String?  @db.Text
  description   String?  @db.Text
  price         Int      // Int
  salePrice     Int?     // Int
  discountPrice Int?     // Int
  costPrice     Int?     // For profit calc
  sku           String?
  stock         Int      @default(0)
  images        Json?    // Legacy JSON images
  
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  
  subcategoryGroupId String?
  subcategoryGroup   SubcategoryGroup? @relation(fields: [subcategoryGroupId], references: [id])
  
  subcategoryItemId String?
  subcategoryItem   SubcategoryItem? @relation(fields: [subcategoryItemId], references: [id])
  
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  isNewArrival  Boolean   @default(false)
  isFlashSale   Boolean   @default(false)
  isPreOrder    Boolean   @default(false)
  expectedDeliveryText String? @db.Text
  
  paymentMethods String   @default("BOTH") // BOTH, COD, ONLINE
  
  affiliateCommissionRate Int @default(0)
  affiliateCommissionType String @default("PERCENT") // PERCENT, FIXED
  
  metaTitle     String?
  metaDescription String? @db.Text
  videoUrl      String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItems    OrderItem[]
  variants      ProductVariant[]
  productImages ProductImage[]
  landingPages  LandingPageProduct[]
  wishlistItems Wishlist[]
  reviews       Review[]
  cartItems     CartItem[]
  flashSaleItems FlashSaleItem[]
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  size            String?
  color           String?
  stock           Int     @default(0)
  priceAdjustment Int?    @default(0) // Int
  price           Int?    // Optional override
  sku             String?
  isActive        Boolean @default(true) // For disabling a variant
  
  images          ProductImage[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cartItems       CartItem[]

  @@unique([productId, size, color])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String

  sortOrder Int     @default(0)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  color     String? // Optional mapping
  
  createdAt DateTime @default(now())
}

model Category {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  image          String?
  isActive       Boolean       @default(true)
  showInMegaMenu Boolean       @default(true)
  showInTopbar   Boolean       @default(false)
  showOnHomepage Boolean       @default(false)
  sortOrder      Int           @default(0)
  
  subcategoryGroups SubcategoryGroup[]
  products          Product[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model SubcategoryGroup {
  id          String            @id @default(cuid())
  name        String            // Display title (e.g. TOPWEAR)
  title       String?           // Alias for name if needed
  slug        String            @unique
  image       String?
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  items       SubcategoryItem[]
  products    Product[]
  
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SubcategoryItem {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  
  groupId       String
  group         SubcategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  products      Product[]
  
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique // Readable ID e.g. ORD-123456
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  
  customerName    String
  phone           String
  address         String
  city            String?
  
  items           OrderItem[]
  
  subtotal        Int       // Int
  discount        Int       @default(0)
  deliveryFee     Int       @default(0) // Int
  deliveryArea    String?   // "INSIDE_DHAKA", "OUTSIDE_DHAKA"
  total           Int       // Int
  
  couponCode      String?
  
  status          String    @default("PENDING") // PENDING, CONFIRMED, PACKED, SHIPPED, DELIVERED, CANCELLED
  paymentMethod   String    @default("COD")   // COD, ONLINE
  paymentStatus   String    @default("PENDING") // PAID, PARTIAL_PAID, PENDING, FAILED
  isAbnormal      Boolean   @default(false)
  advancePayment  Int       @default(0) // Int
  
  courierName     String?   // "eDesh", "Steadfast", "Pathao", etc.
  trackingNumber  String?   // Tracking ID from courier
  
  customerNote    String?   @db.Text
  adminNote       String?   @db.Text
  
  shippingAddress Json?     // Legacy snapshot backup
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  history         OrderStatusHistory[]
  affiliateTransaction AffiliateTransaction?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
  
  variantId String? // If variant selected
  name      String
  quantity  Int
  unitPrice Int     // Store snapshot price (Int)
  total     Int     // quantity * unitPrice (Int)
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  street    String
  city      String
  area      String?
  isDefault Boolean @default(false)
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("text") // text, boolean, json
  isPublic  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  isActive  Boolean  @default(true)
  
  heroTitle String?
  heroDescription   String?
  heroBtn   String?
  heroLink  String?
  heroImageUrl String?
  ctaText   String? @default("Buy Now")
  
  countdownEnd DateTime?
  discountCode String?
  showTestimonials Boolean @default(false)
  testimonialsJson String? @db.Text
  
  products LandingPageProduct[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPageProduct {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  sortOrder     Int         @default(0)
}


model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  status    String   @default("NEW") // NEW, READ, REPLIED
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String   // NEW_ORDER, LOW_STOCK, RETURN_REQUEST
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    @default("PERCENT") // PERCENT, FIXED
  discountValue  Int       // Value per type
  minOrderAmount Int?      // Min subtotal required
  maxUsage       Int?      // Max total usages allowed
  usedCount      Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model FlashSale {
  id        String          @id @default(cuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean         @default(true)
  items     FlashSaleItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model FlashSaleItem {
  id          String    @id @default(cuid())
  flashSaleId String
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  salePrice   Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([flashSaleId, productId])
}

model HomepageConfig {
  id            String   @id @default(cuid())
  heroTitle     String?
  heroSubtitle  String?
  heroButtonText String?
  heroButtonLink String?
  heroImageUrl  String?
  
  // Floating Product Card Fields
  heroProductTitle String?
  heroProductPrice String?
  heroProductImage String?
  heroProductLink  String?
  
  // Custom Styling / Config
  heroTheme      String?  @default("light") // light, dark
  
  showFeatured    Boolean @default(true)
  showNewArrivals Boolean @default(true)
  showTopSelling  Boolean @default(true)
  showFlashSale   Boolean @default(true)
  
  updatedAt     DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  images    Json?    // Added for photo reviews
  isVerified Boolean @default(false) // Added to mark purchaser reviews
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())
}

model Blacklist {
  id        String   @id @default(cuid())
  phone     String?  // Phone number to block
  ip        String?  // IP address to block
  reason    String?  // Why they were blocked
  blockedBy String?  // Admin ID
  createdAt DateTime @default(now())

  @@unique([phone])
}

model AffiliateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String   @unique // The unique referral code they share
  totalEarnings   Int      @default(0) // Lifetime earnings in cents/paisa
  pendingEarnings Int      @default(0) // Earnings yet to be paid out
  isActive        Boolean  @default(true) // We will keep this for backwards compat, but 'status' is the new source of truth
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    AffiliateTransaction[]
  withdrawRequests WithdrawRequest[]
}

model AffiliateTransaction {
  id               String   @id @default(cuid())
  affiliateId      String
  affiliate        AffiliateProfile @relation(fields: [affiliateId], references: [id])
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id])
  commissionAmount Int      // Amount earned for this order
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WithdrawRequest {
  id            String   @id @default(cuid())
  affiliateId   String
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount        Int      // Requested withdrawal amount (paisa/taka)
  paymentMethod String   // bKash, Nagad, Bank
  paymentNumber String   // Account/phone number
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote     String?  // Rejection reason or note
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Banner {
  id        String    @id @default(cuid())
  text      String
  link      String?
  isActive  Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PreOrderRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  details   String   @db.Text
  imageUrl  String?
  status    String   @default("PENDING") // PENDING, CONTACTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CostProfile {
  id              String   @id @default(cuid())
  name            String   
  totalBuyingCost Int      
  quantity        Int
  shippingCost    Int      @default(0)
  adSpend         Int      @default(0)
  packagingCost   Int      @default(0)
  otherCosts      Int      @default(0)
  targetMargin    Int      @default(0) 
  suggestedPrice  Int      @default(0)
  costPerItem     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
